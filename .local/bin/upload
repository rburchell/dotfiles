#!/bin/sh
set -euo pipefail

if [ -z ${1+x} ]; then
    echo "$0: need a filename to upload"
    exit 1
fi

if ! [ -f "$1" ]; then
    echo "$0: file $1 does not exist"
    exit 1
fi

file="$1"
source ~/.config/upload.env

curl -fT "$file" -u "$user:$password" "$upload_server"
echo "$public_server$(basename "$file")"
