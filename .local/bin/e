#!/bin/sh

"$HOME/.local/bin/dotfiles-autosync"
autosync_status=$?
# Pass the result with this frame, so Emacs can notify after attachment without
# a separate client request or a pause. Escape the path as a Lisp string.
autosync_cache=$(printf '%s' "${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles-autosync/" | sed 's/\\/\\\\/g; s/"/\\"/g')

exec emacsclient -t --alternate-editor='' -c \
    -F "((rb-autosync . ($autosync_status \"$autosync_cache\")))" "$@"
